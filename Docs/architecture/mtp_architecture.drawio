        <mxCell id="m1" value="&lt;b&gt;Deformation modes (ablation)&lt;/b&gt;&lt;br&gt;aware: deformed image, tracked face pose&lt;br&gt;unaware: deformed image, nominal pose&lt;br&gt;rigid: no deformation, probe on the skin" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#8a6bb8;fontSize=12;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="820.0" y="450.0" width="420.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;Physics side (server only)&lt;/b&gt;&lt;br&gt;1 kHz loop applies F = F0 + K_c(δ − δ0) to the robot;&lt;br&gt;it never waits on the FEM" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#3f8f99;fontSize=12;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="820.0" y="610.0" width="420.0" height="100.0" as="geometry" />
        </mxCell>
