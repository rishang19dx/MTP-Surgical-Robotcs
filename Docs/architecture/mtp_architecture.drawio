        </mxCell>
        <mxCell id="bsolve" value="&lt;b&gt;BatchedFEMSolver&lt;/b&gt;&lt;br&gt;N probe poses at once · active-set contact along the face normal&lt;br&gt;force by bisection on indentation · displacement field u(X)&lt;br&gt;warp_to_reference (backward Eulerian warp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7743b;fontSize=12;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="610.0" y="275.0" width="520.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="adm" value="&lt;b&gt;Admittance control&lt;/b&gt;&lt;br&gt;δ in [first contact, max] so F ≈ target (4 N)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7743b;fontSize=12;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="610.0" y="405.0" width="250.0" height="70.0" as="geometry" />
        </mxCell>
        <mxCell id="stiff" value="&lt;b&gt;Strain stiffening&lt;/b&gt;&lt;br&gt;β = 0.15/mm on the force law" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7743b;fontSize=12;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
