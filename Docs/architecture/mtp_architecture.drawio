        <mxCell id="fem" value="&lt;b&gt;FEMTissueModel&lt;/b&gt;&lt;br&gt;linear tetrahedral FEM, 4 mm elements&lt;br&gt;Dirichlet: ROI deep + side faces, bone cells&lt;br&gt;precomputed Green's functions (3-direction skin compliance)&lt;br&gt;options: region_modulus · sliding interface · e_fat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7743b;fontSize=12;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
