  <diagram id="diagram_1795350216955117" name="One simulation step">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="&lt;b&gt;One simulation step (Flow C)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;single env and batched vector env follow the same chain; a parity test checks they agree&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;fontSize=22;fontColor=#1f2430;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20.0" y="10.0" width="1200.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Action&lt;/b&gt;&lt;br&gt;[dc1, dc2, dyaw, dpitch] ∈ [−1, 1] (+ optional target force)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a6bb8;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="90.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Probe pose on the undeformed skin&lt;/b&gt;&lt;br&gt;skin height map, frame P, clipped to the scan window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a6bb8;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="210.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;First contact&lt;/b&gt;&lt;br&gt;FEM first_contact_indentation (can be &lt; 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7743b;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="330.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Admittance loop&lt;/b&gt;&lt;br&gt;δ ∈ [first contact, max indentation] so F_tissue(δ) ≈ 4 N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7743b;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="450.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;FEM solve&lt;/b&gt;&lt;br&gt;active-set contact on the precomputed skin compliance&lt;br&gt;→ force F, contact stiffness K_c, displacement field u(X), deformed skin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7743b;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="570.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Backward warp + slice&lt;/b&gt;&lt;br&gt;X = x − u(X) (fixed point, GPU), grid_sample CT and labels at the face pose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9a55;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="690.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;B-mode&lt;/b&gt;&lt;br&gt;model-based: attenuation, interfaces, speckle, TGC; coupling κ(force, tilt) as dB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9a55;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="810.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Perception (image only)&lt;/b&gt;&lt;br&gt;confidence → segment_from_bmode → back-projection → point cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9a55;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="930.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;Task evaluation&lt;/b&gt;&lt;br&gt;reward, termination, metrics (labels allowed here only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a6bb8;fontSize=13;fontColor=#1f2430;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="1050.0" width="640.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="e_1795350219911928" value="" style="edgeStyle=none;strokeColor=#555b66;strokeWidth=1.5;fontSize=11;fontColor=#3a3f4a;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="c1" target="c2">
